# Copy to .env (gitignored) for local compose, or set as GitHub Actions
# secrets for deployment. NEVER commit real values.

# MongoDB Atlas — DRIVER uri (not the atlas-sql one), with db name appended
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster-host>/flood_monitor/?retryWrites=true&w=majority

# Public broker for the demo; later swap to your droplet's Mosquitto
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883

# Topic prefix matching the master nodes' "deploy" NVS key:
# floodwatch/<MQTT_DEPLOY>/<village>/...
MQTT_DEPLOY=

# Redis between parser and API (compose service name inside the stack)
REDIS_URL=redis://redis:6379
